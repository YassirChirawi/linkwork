# Configuration de l'orchestrateur LinkedIn
# Copiez ce fichier vers .env et personnalisez vos valeurs

# Chemins de session et CV
SESSION_STORAGE_PATH="./state.json"
RESUME_PATH="./assets/Mon_CV.pdf"

# Mode d'affichage du navigateur (true = visible pour surveillance humaine, false = headless)
HEADLESS=false

# Profil candidat par défaut pour Easy Apply
CANDIDATE_FIRST_NAME="Yassir"
CANDIDATE_LAST_NAME="Chirawi"
CANDIDATE_PHONE="+33612345678"
CANDIDATE_EMAIL="yassir.chirawi@example.com"
CANDIDATE_CITY="Paris"
CANDIDATE_EXPERIENCE_YEARS="4"
CANDIDATE_SALARY_EXPECTATION="60000"

# Quotas par session
MAX_EASY_APPLY=15
MAX_NETWORKING=15
MAX_OUTREACH=10
